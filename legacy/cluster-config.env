# =============================================================================
# AI Cluster Configuration
# =============================================================================

# Root node (MacBook Pro A1502 - Fedora)
# Current Wi-Fi IP (check with: ip addr show wlp3s0)
ROOT_IP="192.168.1.100"

# Worker 1 (MacBook Air A1465 - antiX, via Wi-Fi)
# Set this to the Air's IP once booted
WORKER1_IP="192.168.1.X"

# Worker 2 (Jailbroken iPhone - via USB tether)
# iPhone gets 172.20.10.x when using Personal Hotspot over USB
WORKER2_IP="10.0.0.X"

# Worker 3 (Android phone - via USB tether or Wi-Fi)
# Android Wi-Fi: 192.168.1.X  | USB tether: check ip route on Fedora
WORKER3_IP="192.168.1.X"

# RPC port (default 50052)
RPC_PORT="50052"

# Model file (relative to the legacy/ directory or absolute path)
MODEL_PATH="../models/qwen2.5-1.5b-instruct-q4_k_m.gguf"

# Number of GPU layers to offload (99 = all, 0 = CPU only)
N_GPU_LAYERS="0"
