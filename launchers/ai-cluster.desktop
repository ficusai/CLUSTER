[Desktop Entry]
Type=Application
Name=AI Cluster (Root)
GenericName=AI Cluster Root Coordinator
Comment=Start the AI cluster root coordinator and open the dashboard
Exec=sh -c '"$HOME/ai-cluster/ai-cluster-desktop-root.sh"'
Icon=ai-cluster
Terminal=false
StartupNotify=true
Categories=System;Monitor;
Keywords=cluster;ai;root;inference;dashboard;
TryExec=ai-cluster
Actions=Stop;Logs;

[Desktop Action Stop]
Name=Stop Cluster
Exec=sh -c '"$HOME/ai-cluster/ai-cluster-stop.sh"'
Icon=ai-cluster

[Desktop Action Logs]
Name=View Logs
Exec=sh -c '"$HOME/ai-cluster/ai-cluster-logs.sh"'
Icon=ai-cluster
