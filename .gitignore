# AI Cluster Auto-Connect — Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
dist/*
!dist/.gitkeep
build/*
!build/*.sh
!build/.gitkeep
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs & runtime data
logs/
*.log
*.pid
.run.log
.run.pid

# Environment / secrets
.env
.env.local
*.pem
*.key
android_ssh_key*
*.p12
*.pfx

# Binaries and Models
bin/*
!bin/.gitkeep
models/*
!models/.gitkeep
*.gguf

# Runtime state (PID/lock files written by launcher scripts)
runtime/*
!runtime/.gitkeep

# Tooling and Caches
.codescope.json
.loomignore
.obsidian-index/

# Dead-code archive (kept locally only, not published)
DEAD-CODE/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
